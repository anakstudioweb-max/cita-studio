# Postgres (required) — Supabase pooler recommended for serverless/Vercel
# Transaction pooler (IPv4-friendly):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Direct (may be IPv6-only):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Cookie/session signing (min 32 characters)
SESSION_SECRET=change-me-to-a-long-random-string

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (optional JS client / future Storage & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google OAuth (button stays disabled until set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
