# Postgres (required) — Supabase pooler recommended for serverless/Vercel
# Prefer SESSION pooler (:5432) so admin writes work (transaction :6543 can be read-only):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (reads OK; writes may fail as read-only):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Direct (may be IPv6-only):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Cookie/session signing (min 32 characters)
SESSION_SECRET=change-me-to-a-long-random-string

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (optional JS client / future Storage & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google OAuth (button stays disabled until set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Booking notifications (optional — booking succeeds without these)
RESEND_API_KEY=
RESEND_FROM="Anak.Studio <onboarding@resend.dev>"  # replace after domain verify
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=+1...
OWNER_NOTIFY_EMAIL=  # owner's inbox for every booking

# Telnyx SMS is DISABLED in booking notify (no 10DLC). Env vars may remain
# unused; staff get a copy-paste SMS/WhatsApp text in booking emails instead.
